generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CategoryType {
  PROJECT
  SKILL
  BLOG
  EMPLOYMENT_TYPE
}

model Category {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  type         CategoryType
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  skills       Skill[]
  experiences  Experience[]

  @@unique([name, type])
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  username  String    @unique
  email     String    @unique
  password  String
  role      UserRole  @default(USER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile?
  media     Media[]
  projects  Project[]
  skills    Skill[]
  experiences Experience[]
  educations Education[]
  certifications Certification[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  bio       String?
  location  String?
  timezone  String?
  github    String?
  linkedin  String?
  twitter   String?
  website   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String    @id @default(cuid())
  originalName String
  publicId     String    @unique
  url          String
  secureUrl    String
  resourceType String
  format       String
  width        Int?
  height       Int?
  bytes        Int
  folder       String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  certifications Certification[]
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status       ProjectStatus @default(DRAFT)
  technologies String[]
  liveUrl      String?
  githubUrl    String?
  featured     Boolean       @default(false)

  thumbnailMediaId String?
  thumbnail        Media?  @relation(fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id                String   @id @default(cuid())
  name              String
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  proficiency       Int      @default(0) // 0-100
  yearsOfExperience Int      @default(0)
  displayOrder      Int      @default(0)

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Experience {
  id               String    @id @default(cuid())
  company          String
  role             String
  employmentTypeId String
  employmentType   Category  @relation(fields: [employmentTypeId], references: [id], onDelete: Restrict)
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  description      String?
  responsibilities String[]
  technologies     String[]
  displayOrder     Int       @default(0)

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  gpa          String?
  location     String?
  description  String?
  activities   String[]
  displayOrder Int       @default(0)

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Certification {
  id                 String    @id @default(cuid())
  name               String
  issuer             String
  issueDate          DateTime
  expiryDate         DateTime?
  credentialId       String?
  verificationUrl    String?
  certificateMediaId String?
  certificateMedia   Media?    @relation(fields: [certificateMediaId], references: [id], onDelete: SetNull)
  displayOrder       Int       @default(0)

  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
